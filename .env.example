# Copy this file to .env and fill in your keys.

# Aholo Lux3D key from https://labs.aholo.ai (raw key, no "Bearer")
AHOLO_API_KEY=

# Optional. The AI agent builds each fighter card from the photo and writes the match recap.
# OpenAI is used first when set. Without any key the game uses a rules based builder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Lux3D quality for photos: G1-Turbo (fast, 1 credit) or G1 (best, 20 credits)
LUX3D_VERSION=G1-Turbo

# Run Lux3D part split so fighters lose their real parts in battle (30 credits each)
# Set to 0 to save credits. The game then cuts the mesh into chunks by itself.
LUX3D_PART_SPLIT=1

# Mesh size sent to Lux3D. Lower loads faster in the browser.
LUX3D_FACE_COUNT=20000

PORT=8787
